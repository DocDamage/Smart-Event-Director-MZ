{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/sed/scene.schema.json",
  "title": "Smart Event Director Scene",
  "type": "object",
  "required": ["schema", "sceneId", "steps"],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["SED_SCENE_1"]
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "canSkip": {
      "type": "boolean"
    },
    "timeoutFrames": {
      "type": "number",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "$ref": "#/definitions/dialogueStep"
        },
        {
          "$ref": "#/definitions/narrationStep"
        },
        {
          "$ref": "#/definitions/choiceStep"
        },
        {
          "$ref": "#/definitions/waitStep"
        },
        {
          "$ref": "#/definitions/switchStep"
        },
        {
          "$ref": "#/definitions/variableStep"
        },
        {
          "$ref": "#/definitions/fadeOutStep"
        },
        {
          "$ref": "#/definitions/fadeInStep"
        },
        {
          "$ref": "#/definitions/moveOneTileStep"
        },
        {
          "$ref": "#/definitions/moveToStep"
        },
        {
          "$ref": "#/definitions/moveRouteStep"
        },
        {
          "$ref": "#/definitions/lockPlayerStep"
        },
        {
          "$ref": "#/definitions/unlockPlayerStep"
        },
        {
          "$ref": "#/definitions/labelStep"
        },
        {
          "$ref": "#/definitions/jumpStep"
        },
        {
          "$ref": "#/definitions/loopStep"
        },
        {
          "$ref": "#/definitions/endLoopStep"
        },
        {
          "$ref": "#/definitions/conditionStep"
        },
        {
          "$ref": "#/definitions/scriptStep"
        },
        {
          "$ref": "#/definitions/commentStep"
        },
        {
          "$ref": "#/definitions/commonEventStep"
        },
        {
          "$ref": "#/definitions/selfSwitchStep"
        },
        {
          "$ref": "#/definitions/audioStep"
        },
        {
          "$ref": "#/definitions/pictureStep"
        },
        {
          "$ref": "#/definitions/cameraStep"
        },
        {
          "$ref": "#/definitions/weatherStep"
        },
        {
          "$ref": "#/definitions/transitionStep"
        },
        {
          "$ref": "#/definitions/titleCardStep"
        },
        {
          "$ref": "#/definitions/startQuestStep"
        },
        {
          "$ref": "#/definitions/updateObjectiveStep"
        },
        {
          "$ref": "#/definitions/completeQuestStep"
        },
        {
          "$ref": "#/definitions/failQuestStep"
        },
        {
          "$ref": "#/definitions/questRewardStep"
        },
        {
          "$ref": "#/definitions/relationshipStep"
        }
      ]
    },
    "dialogueStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["dialogue"]
        },
        "speaker": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "faceName": {
          "type": "string"
        },
        "faceIndex": {
          "type": "number"
        },
        "textSpeed": {
          "type": "number"
        },
        "autoAdvance": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "narrationStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["narration"]
        },
        "text": {
          "type": "string"
        },
        "textSpeed": {
          "type": "number"
        },
        "autoAdvance": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "choiceStep": {
      "type": "object",
      "required": ["type", "key", "prompt", "options"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["choice"]
        },
        "key": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "jump": {
                "type": "string"
              }
            }
          }
        },
        "cancel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "defaultIndex": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "waitStep": {
      "type": "object",
      "required": ["type", "frames"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["wait"]
        },
        "frames": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "switchStep": {
      "type": "object",
      "required": ["type", "id", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["switch"]
        },
        "id": {
          "type": "number"
        },
        "value": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "variableStep": {
      "type": "object",
      "required": ["type", "id", "operation", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["variable"]
        },
        "id": {
          "type": "number"
        },
        "operation": {
          "type": "string",
          "enum": ["set", "add", "sub", "mul", "div", "mod"]
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "fadeOutStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["fadeOut"]
        },
        "duration": {
          "type": "number"
        },
        "wait": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fadeInStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["fadeIn"]
        },
        "duration": {
          "type": "number"
        },
        "wait": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "moveOneTileStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["moveOneTile"]
        },
        "eventId": {
          "type": "number"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "wait": {
          "type": "boolean"
        },
        "timeoutFrames": {
          "type": "number"
        },
        "failBehavior": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "moveToStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["moveTo"]
        },
        "eventId": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "wait": {
          "type": "boolean"
        },
        "timeoutFrames": {
          "type": "number"
        },
        "failBehavior": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "moveRouteStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["moveRoute"]
        },
        "eventId": {
          "type": "number"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "wait": {
          "type": "boolean"
        },
        "timeoutFrames": {
          "type": "number"
        },
        "failBehavior": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lockPlayerStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["lockPlayer"]
        }
      },
      "additionalProperties": false
    },
    "unlockPlayerStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["unlockPlayer"]
        }
      },
      "additionalProperties": false
    },
    "labelStep": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["label"]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "jumpStep": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["jump"]
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "loopStep": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["loop"]
        },
        "label": {
          "type": "string"
        },
        "maxIterations": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "endLoopStep": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["endLoop"]
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "conditionStep": {
      "type": "object",
      "required": ["type", "operator"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["condition"]
        },
        "operator": {
          "type": "string"
        },
        "jumpTrue": {
          "type": "string"
        },
        "jumpFalse": {
          "type": "string"
        },
        "elseJump": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scriptStep": {
      "type": "object",
      "required": ["type", "code"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["script"]
        },
        "code": {
          "type": "string"
        },
        "wait": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "commentStep": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["comment"]
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "commonEventStep": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["commonEvent"]
        },
        "id": {
          "type": "number"
        },
        "wait": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "selfSwitchStep": {
      "type": "object",
      "required": ["type", "eventId", "switchId", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["selfSwitch"]
        },
        "eventId": {
          "type": "number"
        },
        "switchId": {
          "type": "string",
          "enum": ["A", "B", "C", "D"]
        },
        "value": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "audioStep": {
      "type": "object",
      "required": ["type", "action", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["audio"]
        },
        "action": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "volume": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        },
        "pan": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "pictureStep": {
      "type": "object",
      "required": ["type", "action", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["picture"]
        },
        "action": {
          "type": "string",
          "enum": ["show", "move", "erase", "tint"]
        },
        "id": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "cameraStep": {
      "type": "object",
      "required": ["type", "action"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["camera"]
        },
        "action": {
          "type": "string",
          "enum": ["scroll", "focus", "reset", "shake", "flash", "tint"]
        }
      },
      "additionalProperties": true
    },
    "weatherStep": {
      "type": "object",
      "required": ["type", "action"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["weather"]
        },
        "action": {
          "type": "string",
          "enum": ["set", "clear", "fade"]
        },
        "weatherType": {
          "type": "string"
        },
        "power": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "wait": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "transitionStep": {
      "type": "object",
      "required": ["type", "effect"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["transition"]
        },
        "effect": {
          "type": "string",
          "enum": ["fade", "fadeWhite", "wipe", "mosaic", "instant"]
        },
        "duration": {
          "type": "number"
        },
        "wait": {
          "type": "boolean"
        },
        "color": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "titleCardStep": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["titleCard"]
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "fadeIn": {
          "type": "number"
        },
        "fadeOut": {
          "type": "number"
        },
        "wait": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "startQuestStep": {
      "type": "object",
      "required": ["type", "questId"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["startQuest"]
        },
        "questId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "updateObjectiveStep": {
      "type": "object",
      "required": ["type", "questId", "objective"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["updateObjective"]
        },
        "questId": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "completeQuestStep": {
      "type": "object",
      "required": ["type", "questId"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["completeQuest"]
        },
        "questId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "failQuestStep": {
      "type": "object",
      "required": ["type", "questId"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["failQuest"]
        },
        "questId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "questRewardStep": {
      "type": "object",
      "required": ["type", "questId"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["questReward"]
        },
        "questId": {
          "type": "string"
        },
        "gold": {
          "type": "number"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "count": {
                "type": "number"
              }
            }
          }
        },
        "weapons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "count": {
                "type": "number"
              }
            }
          }
        },
        "armors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "count": {
                "type": "number"
              }
            }
          }
        },
        "exp": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "relationshipStep": {
      "type": "object",
      "required": ["type", "target", "operation", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["relationship"]
        },
        "target": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "enum": ["set", "add"]
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}
